{
  "manifest_version": 3,
  "name": "HTB Pocket Translator",
  "version": "1.0.0",
  "description": "Tradução contextual pt-BR do HTB Academy no Firefox para Android.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "HTB Pocket Translator",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://academy.hackthebox.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://academy.hackthebox.com/*"
      ],
      "js": [
        "translation-guard.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://academy.hackthebox.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "htb-pocket-translator@nexusguard-labs",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "websiteContent"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
